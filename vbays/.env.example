# ============================================================
# Vbays settings. Copy this file to ".env" and fill it in.
# NEVER share the .env file or put it on GitHub. It holds your keys.
# ============================================================

# --- Identity ---
APP_NAME=Vbays
COMPANY_NAME=Avina Interiors
TIMEZONE=Asia/Kolkata
# te = Telugu, en = English, te-en = Telugu-English mix
DEFAULT_LANGUAGE=te-en

# --- SAFETY SWITCH ---
# true  = nothing goes to real customers or social media (safe for testing)
# false = live. Only switch off after testing each module.
TEST_MODE=true

# --- Web login security ---
# A long random text. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SESSION_MAX_AGE_HOURS=12
# The address you open Vbays at. Use https://… once hosted (makes cookies secure).
BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
# Docker (docker-compose.yml) sets this for you. For Supabase, paste its
# connection string and change "postgresql://" to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://vbays:vbays@localhost:5432/vbays

# --- Claude AI (Anthropic) ---
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Model used for customer replies, content and analysis.
# claude-opus-5 = best quality. claude-sonnet-5 = cheaper. claude-haiku-4-5 = cheapest.
CLAUDE_MODEL=claude-opus-5

# --- Telegram bot (staff + owner) ---
# Create a bot: open Telegram → @BotFather → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2

# --- Marketing (Phase 2): official APIs only, no third-party tools ---
# Instagram: the access token is pasted on Marketing → Connections (not here).
INSTAGRAM_API_VERSION=v24.0
# Google (YouTube + Drive): Google Cloud → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Drive folder your team drops photos/videos into: open it, copy the last part of the web address
GOOGLE_DRIVE_FOLDER_ID=
# LinkedIn developer app (products: Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605
# Voiceover on videos (free Microsoft Edge voices; needs internet). true/false
VOICEOVER_ENABLED=true

# --- Coming in later phases (leave empty for now) ---
# Phase 3: WhatsApp Business Cloud API (Meta)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
